# ========================================
# MD Site Monitor Backend - Environment Variables
# ========================================

# ========================================
# Server Configuration
# ========================================
PORT=3000
NODE_ENV=development

# ========================================
# Database Configuration
# ========================================
DATABASE_URL="postgresql://username:password@localhost:5432/md_site_monitor?schema=public"

# ========================================
# JWT Authentication Configuration
# ========================================
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_REFRESH_SECRET="your-super-secret-refresh-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ========================================
# Password Security Configuration
# ========================================
BCRYPT_ROUNDS=12

# ========================================
# Email Configuration (SMTP)
# ========================================
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
FROM_EMAIL=noreply@mdsitemonitor.com
FROM_NAME="MD Site Monitor"

# ========================================
# Telegram Bot Configuration
# ========================================
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# ========================================
# Application Information
# ========================================
APP_VERSION=1.0.0
APP_NAME="MD Site Monitor Backend"

# ========================================
# Rate Limiting
# ========================================
# API rate limit window (ms) and max requests per IP
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=1200

# Auth rate limit window (ms) and max attempts per IP
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
