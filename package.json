{
  "name": "md-site-monitor-back",
  "version": "1.0.0",
  "description": "Backend API для системы мониторинга сайтов",
  "main": "dist/app.js",
  "scripts": {
    "start": "node dist/app.js",
    "dev": "nodemon",
    "dev:watch": "nodemon --watch src",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "clean": "rm -rf dist",
    "lint": "eslint \"src/**/*.ts\" --ignore-pattern \"src/test/**/*\" --max-warnings=0",
    "lint:fix": "eslint \"src/**/*.ts\" --fix --ignore-pattern \"src/test/**/*\" --max-warnings=0",
    "lint:strict": "eslint \"src/**/*.ts\" --ignore-pattern \"src/test/**/*\" --max-warnings=0",
    "format": "prettier --write \"src/**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,json,md}\"",
    "code:check": "npm run lint && npm run format:check",
    "code:fix": "npm run lint:fix && npm run format",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest src/test/unit",
    "test:all": "jest",
    "test:ci": "jest --ci --coverage",
    "check:ci": "npm run lint && npm run test:ci",
    "prepare": "husky install"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/makedifference-dev/md-site-monitor-back.git"
  },
  "keywords": [
    "express",
    "typescript",
    "api",
    "monitoring",
    "backend",
    "swagger",
    "openapi"
  ],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/makedifference-dev/md-site-monitor-back/issues"
  },
  "homepage": "https://github.com/makedifference-dev/md-site-monitor-back#readme",
  "dependencies": {
    "@prisma/client": "^6.14.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/nodemailer": "^7.0.1",
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.0.0-beta.1",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "nodemailer": "^7.0.5",
    "swagger-jsdoc": "^6.2.8",
    "swagger-typescript-api": "^13.2.8",
    "swagger-ui-express": "^5.0.0",
    "telegraf": "^4.16.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.12",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.2",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.6",
    "@typescript-eslint/eslint-plugin": "^8.40.0",
    "@typescript-eslint/parser": "^8.40.0",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "prettier": "^3.3.3",
    "prisma": "^6.14.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.2",
    "tsconfig-paths": "^4.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "husky": "^9.0.11"
  }
}
